# Kök .env — sadece `docker-compose.yml` tarafından okunur (Bölüm 14).
# `api/.env` ve `web/.env` (Docker olmadan yerel geliştirme için) ayrı,
# kendi klasörlerindeki `.env.example` dosyalarına bakın.
#
# Kullanım: bu dosyayı `.env` olarak kopyalayıp değerleri doldurun, sonra:
#   docker compose up --build

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=roomsync
POSTGRES_PORT=5432

# --- api ---
API_PORT=4000
# Güçlü, rastgele değerler kullanın (örn. `openssl rand -base64 32`) — asla
# basit bir metin değil.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Panelin tarayıcıda çalıştığı gerçek origin. Yerelde varsayılan aşağıdaki
# gibi kalabilir; canlıda DuckDNS domain'inizle değiştirilecek (Bölüm 15,
# madde 7 — bu faz henüz deploy'u kapsamıyor, sadece bu değişkeni
# hardcode etmeden yapılandırılabilir tutuyoruz).
CORS_ORIGIN=http://localhost:3000

# --- web ---
WEB_PORT=3000
# ⚠️ Build-time'da client bundle'a gömülür (bkz. web/Dockerfile) — bu image'ı
# yeniden build etmeden değiştirilemez. Tarayıcıdan erişilebilir bir adres
# olmalı (container ağındaki "api" servis adı değil). Canlıda DuckDNS
# domain'inizin API alt domaini ile değiştirilecek (örn.
# https://api.roomsync.duckdns.org).
NEXT_PUBLIC_API_URL=http://localhost:4000
